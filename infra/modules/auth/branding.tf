# ── Managed login branding ──────────────────────────────────────
# The style the sign-in pages render with: colours, the wordmark above the
# form, the favicon on the tab. Cognito serves the pages; nothing here is
# hosted by us. Requires provider >= 6.12.0.
#
# PART OF AUTH, AND SO OWNED HERE (insolvia ADR 0026, amended 2026-10-12): the
# sign-in page is the login service's face, so its style lives with the pool
# and the clients it styles. It was briefly the insolvia repo's, because
# insolvia GENERATED these files from its brand; that generator no longer
# writes them.
#
# THE FILES BESIDE THIS ONE ARE CHECKED IN, NOT GENERATED HERE:
# managed-login-settings.json, wordmark-light.svg, wordmark-dark.svg,
# favicon.svg. They were last generated by insolvia's `npm run tokens` on
# 2026-10-12 and are now edited in this repository. Brand consistency is meant
# to come from the design system (@insolvia-ai/tokens); until this module
# renders them from that published package, a re-brand means updating them
# here by hand, and nothing checks them against the app. Keep JSON keys AWS's:
# AWS rejects unknown ones, so the file cannot carry its own comment — this is
# it.
#
# Its STRUCTURE — layout, border radii, which auth methods appear — is AWS's
# schema, owned by the console's branding editor. To change layout: edit in the
# console, re-export with DescribeManagedLoginBrandingByClient
# (ReturnMergedResources), and commit the result, restoring the brand colours
# over whatever the console wrote.
#
# ONE ASSET FAMILY, THE MARKS, and no others. The export merges in Cognito's
# OWN illustrations (email, SMS, passkey and password graphics, provider
# icons). Those are AWS's artwork; assets we do not declare are left alone, so
# Cognito keeps supplying them.
#
# BRANDING IS PER APP CLIENT, and a client on managed login with no style does
# not fall back to defaults — it serves "Login pages unavailable". That is why
# both domains depend on these (main.tf): with the pool, clients, domains and
# styles in one module again, "managed login on, nothing to render" is
# unreachable within an apply. The MCP harness clients carry no style — they
# never show this page to a person in a browser of ours.

resource "aws_cognito_managed_login_branding" "web" {
  user_pool_id = aws_cognito_user_pool.main.id
  client_id    = aws_cognito_user_pool_client.web.id

  settings = file("${path.module}/managed-login-settings.json")

  # The wordmark is TWO assets, one per colour mode, because Cognito's
  # light/dark is its own toggle and an <img> served from AWS's origin can only
  # follow the OS. The favicon is one: the tile is dark in both schemes. The
  # API takes base64 (<= 40 assets, 2 MB each); these are ~7 KB of outlines.
  dynamic "asset" {
    for_each = toset(["LIGHT", "DARK"])

    content {
      category   = "FORM_LOGO"
      color_mode = asset.value
      extension  = "SVG"
      bytes      = filebase64("${path.module}/wordmark-${lower(asset.value)}.svg")
    }
  }

  asset {
    category   = "FAVICON_SVG"
    color_mode = "DYNAMIC"
    extension  = "SVG"
    bytes      = filebase64("${path.module}/favicon.svg")
  }
}

# The client portal's door: the same settings and marks as the web client —
# one brand, one sign-in page, whichever door a person comes through.
resource "aws_cognito_managed_login_branding" "portal" {
  user_pool_id = aws_cognito_user_pool.main.id
  client_id    = aws_cognito_user_pool_client.portal.id

  settings = file("${path.module}/managed-login-settings.json")

  dynamic "asset" {
    for_each = toset(["LIGHT", "DARK"])

    content {
      category   = "FORM_LOGO"
      color_mode = asset.value
      extension  = "SVG"
      bytes      = filebase64("${path.module}/wordmark-${lower(asset.value)}.svg")
    }
  }

  asset {
    category   = "FAVICON_SVG"
    color_mode = "DYNAMIC"
    extension  = "SVG"
    bytes      = filebase64("${path.module}/favicon.svg")
  }
}
